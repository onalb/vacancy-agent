FOUNDRY_PROJECT_ENDPOINT=https://onalb-vacancy.services.ai.azure.com/api/projects/vacancy
FOUNDRY_MODEL=vacancy-chat
AZURE_STORAGE_ACCOUNT=onalbvacancy
AZURE_STORAGE_CONTAINER=fits
# Used when DefaultAzureCredential cannot mint a Cognitive Services token (e.g. AADSTS530035).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# When set, parse/fit/load/list/save/score and the checklist tools call POST {URL}/mcp/vacancy.
# Unset keeps those math tools local. The checklist tools then return an error.
# ask_vacancy stays here. Do not point this at a production gateway for local runs.
CAPABILITIES_GATEWAY_URL=http://127.0.0.1:8010
